{
	"name": "flashpdf-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @pettersen3008/flashpdf build",
		"fmt": "oxfmt 'packages/flashpdf/**/*.{ts,tsx,mjs,json,css}' 'packages/playground/**/*.{ts,tsx,json,css}' 'tests/**/*.{ts,mjs,json}' package.json vitest.config.ts",
		"fmt:check": "oxfmt --check 'packages/flashpdf/**/*.{ts,tsx,mjs,json,css}' 'packages/playground/**/*.{ts,tsx,json,css}' 'tests/**/*.{ts,mjs,json}' package.json vitest.config.ts",
		"lint": "oxlint --deny-warnings .",
		"test": "pnpm build && vitest run",
		"test:unit": "pnpm build && vitest run --project unit",
		"test:integration": "pnpm build && vitest run --project integration",
		"test:e2e": "pnpm build && node tests/e2e.mjs",
		"typecheck": "pnpm --filter @pettersen3008/flashpdf typecheck",
		"playground": "pnpm --filter flashpdf-playground dev",
		"playground:build": "pnpm --filter flashpdf-playground build"
	},
	"devDependencies": {
		"@babel/core": "8.1.0",
		"@react-pdf/renderer": "4.9.0",
		"@stylexjs/babel-plugin": "0.19.1",
		"@tailwindcss/cli": "4.3.5",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"binaryen": "132.0.0",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"pdfkit": "0.20.2",
		"playwright": "1.65.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"styled-components": "6.6.0",
		"tailwindcss": "4.3.5",
		"takumi-pdf": "0.19.0",
		"typescript": "7.0.2",
		"vite": "8.3.6",
		"vitest": "5.1.0",
		"wrangler": "4.158.0"
	},
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"packageManager": "pnpm@12.4.2"
}
