{
	"name": "flashpdf-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @pettersen3008/flashpdf build",
		"fmt": "oxfmt 'packages/flashpdf/**/*.{ts,tsx,mjs,json,css}' 'tests/**/*.{ts,mjs,json}' package.json vitest.config.ts",
		"fmt:check": "oxfmt --check 'packages/flashpdf/**/*.{ts,tsx,mjs,json,css}' 'tests/**/*.{ts,mjs,json}' package.json vitest.config.ts",
		"lint": "oxlint --deny-warnings .",
		"test": "pnpm build && vitest run",
		"test:unit": "pnpm build && vitest run --project unit",
		"test:integration": "pnpm build && vitest run --project integration",
		"test:e2e": "pnpm build && node tests/e2e.mjs",
		"typecheck": "pnpm --filter @pettersen3008/flashpdf typecheck"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@react-pdf/renderer": "4.9.0",
		"@stylexjs/babel-plugin": "0.19.1",
		"@tailwindcss/cli": "4.3.3",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"binaryen": "132.0.0",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"pdfkit": "0.20.2",
		"playwright": "1.63.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"styled-components": "6.5.3",
		"tailwindcss": "4.3.3",
		"takumi-pdf": "0.15.0",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.1",
		"wrangler": "4.135.0"
	},
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@12.4.2"
}
